# ============================================
# Configuração central da CitizenTech
# Edite aqui; os scripts leem este arquivo.
# ============================================

PROJECT_NAME="citizentech"
SERVER_HOSTNAME="citizentech-server"
SERVER_DOMAIN="citizentech.local"

# Rede: interface Host-only do VirtualBox
NET_INTERFACE="enp0s8"
STATIC_IP="192.168.56.10"
NETMASK_CIDR="24"
DNS_SERVERS="1.1.1.1,8.8.8.8"

# Pasta de logs
LOG_DIR="/var/log/citizentech"

# Fuso horário dos logs
TIMEZONE="America/Sao_Paulo"

# Instalação e monitoramento
INSTALL_DIR="/opt/citizentech"
MONITOR_INTERVAL=30     # segundos entre cada verificação
LIMITE_CPU=80           # alerta acima de 80%
LIMITE_MEM=80
LIMITE_DISCO=80